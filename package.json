{
  "name": "menu3d",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "pnpm -r test && vitest run scripts",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "validar:demo": "tsx packages/shared/scripts/validar-demo.ts demo/carta.json",
    "preparar:videos": "tsx scripts/preparar-videos.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
